# EJEMPLO PARA REVISIÓN; no aplicar ni reiniciar servicios en Task 14.
# Perfil inicial CPU para qwen3:1.7b; medir primero la reserva del homelab.
# Destino futuro: systemctl edit ollama.service (no modifica Docker).
[Service]
Environment="OLLAMA_HOST=127.0.0.1:11434"
Environment="OLLAMA_NO_CLOUD=1"
Environment="OLLAMA_NUM_PARALLEL=1"
Environment="OLLAMA_MAX_LOADED_MODELS=1"
Environment="OLLAMA_MAX_QUEUE=1"
Environment="OLLAMA_CONTEXT_LENGTH=2048"
Environment="OLLAMA_KEEP_ALIVE=60s"
CPUQuota=200%
MemoryHigh=3G
MemoryMax=4G
MemorySwapMax=0
TasksMax=128
Nice=10
UMask=0077
