{
  "name": "furgoplus-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "contract:generate": "node scripts/generate-api-types.mjs",
    "contract:check": "node scripts/generate-api-types.mjs --check",
    "lint": "oxlint src scripts vite.config.ts",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "jsdom": "27.0.0",
    "oxlint": "1.81.0",
    "prettier": "3.6.2",
    "typescript": "6.0.2",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
