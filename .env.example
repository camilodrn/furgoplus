# Copy to .env and replace placeholders before starting Compose.
DJANGO_SECRET_KEY=replace-with-a-unique-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DB_NAME=furgoplus
DB_USER=furgoplus
DB_PASSWORD=replace-with-a-local-database-password
DB_HOST=db
DB_PORT=5432
API_PUBLIC_ORIGIN=http://localhost:8000
WEB_PUBLIC_ORIGIN=http://localhost:5173
PRIVATE_UPLOAD_ROOT=/var/lib/furgoplus/private

