# Non-secret configuration only. Copy to infra/demo/.env, not the development .env.
FURGOPLUS_RELEASE=demo-816dda0-r1
DEMO_SYNTHETIC_ONLY=true
# Public signup is always closed by config.settings_demo. React's illustrative
# mode is compiled by infra/demo/web.Dockerfile, not a Caddy runtime env switch.
DEMO_HTTP_PORT=18080
# Change these three values together if the subnet conflicts with LAN/VPN/FitFu.
DEMO_PROXY_SUBNET=172.30.81.0/29
DEMO_CADDY_IP=172.30.81.2
DEMO_BACKEND_IP=172.30.81.3
# Existing, manually provisioned files OUTSIDE the repository. No values here.
DJANGO_SECRET_KEY_PATH=/etc/furgoplus/demo/django_secret_key
DB_PASSWORD_PATH=/etc/furgoplus/demo/db_password
