{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	encode gzip
	@api path /api /api/*
	handle @api {
		header Cache-Control no-store
		request_body {
			max_size 11MiB
		}
		reverse_proxy backend:8000 {
			header_up X-Forwarded-Proto {$TASK16_SCHEME:http}
		}
	}
	@private path /admin /admin/* /media /media/* /private /private/* /static /static/*
	handle @private {
		respond 404
	}
	handle {
		root * /srv
		header Cache-Control no-cache
		try_files {path} /index.html
		file_server
	}
}
